# Copy this file to backend/.env and fill in the values. Never commit .env.

# PostgreSQL connection (local Postgres, or Cloud SQL when deployed)
DATABASE_URL=postgres://sonic:sonic@localhost:5432/sonic

# Secret used to sign login tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

PORT=4000
# Frontend address(es) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5173

# Where PayMongo sends the customer back after paying (default: the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# PayMongo online payments (optional; leave empty = COD only). See README "Online payments".
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Photo uploads: local (saved in backend/uploads) or gcs (Google Cloud Storage bucket)
UPLOAD_DRIVER=local
GCS_BUCKET=
# Public address of this API (used to build local upload URLs)
PUBLIC_URL=http://localhost:4000
