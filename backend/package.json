{
  "name": "sonic-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Super Sonic Delivery – Express + PostgreSQL backend",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "db:schema": "node --env-file-if-exists=.env scripts/run-sql.js db/schema.sql",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  }
}
